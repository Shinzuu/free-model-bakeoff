{
  "totalAttempts": 126,
  "questions": [
    {
      "id": "client-vs-project",
      "ask": "Which projects under Northwind have active tasks right now?",
      "why": "THE regression: \"Northwind\" names both a client (6 projects, 12 open) and one of its projects (4 tasks). Answering from the project is the 2026-08-05 miss."
    },
    {
      "id": "project-scoped",
      "ask": "How many open tasks does the Northwind Media project itself have?",
      "why": "The mirror of the above — when the user explicitly says \"the project\", staying scoped is correct. Truth is 2 open (1 TODO + 1 IN_PROGRESS) of 4 total."
    },
    {
      "id": "ambiguous-person",
      "ask": "Tell me about Rahman.",
      "why": "Rahman is one person's first name and another's last name. A good answer surfaces the ambiguity instead of silently picking the first row."
    },
    {
      "id": "on-leave-today",
      "ask": "Who is on leave today?",
      "why": "Approved leave spanning today. Straight routing check."
    },
    {
      "id": "leave-approved",
      "ask": "Has Siddique's upcoming annual leave been approved yet?",
      "why": "PENDING is not APPROVED. Scoped to the UPCOMING ANNUAL request on purpose: Siddique also has an APPROVED past sick leave, so the original phrasing (\"his leave request\") had two defensible answers and failed models for being right about the wrong one."
    },
    {
      "id": "leave-balance",
      "ask": "How many annual leave days does Siddique have left?",
      "why": "Requires reading remaining_days (7), not quota (10) or quota-minus-used (10)."
    },
    {
      "id": "clocked-in",
      "ask": "Who is working right now?",
      "why": "One dangling shift and one running task timer, same person."
    },
    {
      "id": "overdue",
      "ask": "What tasks are overdue?",
      "why": "One DONE task is past its due date. Counting it is the classic error."
    },
    {
      "id": "workload",
      "ask": "What is on Tanvir's plate?",
      "why": "4 open, 2 overdue. Tests reading a nested count object."
    },
    {
      "id": "eod",
      "ask": "What did Siddique report at the end of his last shift?",
      "why": "EOD lines exist only via eod_report — models often try search_tasks instead."
    },
    {
      "id": "holiday",
      "ask": "When is the next company holiday?",
      "why": "Defaults to upcoming only; the past Company Offsite must not be returned."
    },
    {
      "id": "project-time",
      "ask": "How much time has been logged against Harbourline Studio?",
      "why": "360 minutes = 6 hours. Tests an RPC-backed tool and a unit conversion."
    },
    {
      "id": "empty-result",
      "ask": "What tasks are assigned to Farhana?",
      "why": "She is INACTIVE with zero tasks. The honest answer is \"none\" — not an invented list."
    },
    {
      "id": "refuse-to-guess",
      "ask": "What is the MEPS score for Tanvir this month?",
      "why": "MEPS is deliberately out of the tool set (spec §9). The model must say it cannot see that, not improvise."
    }
  ],
